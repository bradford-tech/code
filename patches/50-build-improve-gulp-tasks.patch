diff --git a/build/gulpfile.reh.ts b/build/gulpfile.reh.ts
--- a/build/gulpfile.reh.ts
+++ b/build/gulpfile.reh.ts
@@ -537,2 +537,8 @@ ['reh', 'reh-web'].forEach(type => {
 	const esbuildBundleMinTask = task.define(`esbuild-vscode-${type}-min`, () => runEsbuildBundle(`out-vscode-${type}-min`, true, true, target, `https://main.vscode-cdn.net/sourcemaps/${commit}/core`));
+	// Registered so build.sh can run the REH bundle on its own, between
+	// `vscode-min-prepack` and `vscode-reh-<platform>-<arch>-min-ci`. Upstream

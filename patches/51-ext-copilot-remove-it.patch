-		return result;
-	}
-	const colonIdx = token.indexOf(':');
-	const header = colonIdx === -1 ? token : token.substring(0, colonIdx);
-	for (const field of header.split(';')) {
-		const eqIdx = field.indexOf('=');
-		if (eqIdx <= 0) {
-			continue;
-		}
-		result.set(field.substring(0, eqIdx), field.substring(eqIdx + 1));
-	}
-	return result;
-}

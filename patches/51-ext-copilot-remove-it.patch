-function sleep(ms: number, signal: AbortSignal): Promise<void> {
-	return new Promise<void>(resolve => {
-		if (signal.aborted) {
-			resolve();
-			return;
-		}
-		const done = () => {
-			clearTimeout(handle);
-			signal.removeEventListener('abort', done);
-			resolve();
-		};
-		const handle = setTimeout(done, ms);
-		signal.addEventListener('abort', done);
-	});
-}

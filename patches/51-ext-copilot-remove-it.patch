-	private _showProgress(waiter: IManagedSettingsWaiter): void {
-		if (!waiter.report || waiter.shown) {
-			return;
-		}
-		waiter.shown = true;
-		waiter.report(localize('copilot.managedSettings.pending', "Loading your organization's managed settings"));
-	}

+	degradedToPhaseId?: string;
+	durationMs: number;
+	errorMessage?: string;
+	fusionId: string;
+	model: string;
+	phaseId: string;
+	phaseKind: FusionPhaseKind;
+	reason: string;
+	reasoningEffort?: string;

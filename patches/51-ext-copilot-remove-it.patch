-		let payload = parseJsonObject(rawPayload);
-		if (!payload) {
-			return line;
-		}
-		let rewritten = false;
-		if (payload.prompt_progress !== undefined) {
-			if (isPromptProgressOnly(payload)) {
-				this._skipSeparator = true;
-				return undefined;

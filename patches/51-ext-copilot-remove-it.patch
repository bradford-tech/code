+	'assistant.fusion_phase_completed': AssistantFusionPhaseCompletedEvent;
+	'assistant.fusion_phase_failed': AssistantFusionPhaseFailedEvent;
+	'session.fusion_completed': FusionCompletedEvent;
+}

-const HOOK_TYPE_TO_SDK_KEY: Record<string, keyof SessionHooks> = {
-	'PreToolUse': 'onPreToolUse',
-	'PostToolUse': 'onPostToolUse',
-	'UserPromptSubmit': 'onUserPromptSubmitted',

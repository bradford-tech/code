-function normalizeMcpServerUrl(value: string): string | undefined {
-	if (!URL.canParse(value)) {
-		return undefined;
-	}
-	const url = new URL(value);
-	url.hash = '';
-	url.pathname = url.pathname.replace(/\/+$/, '');
-	return url.href;
-}

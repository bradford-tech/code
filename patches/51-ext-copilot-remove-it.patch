-		const content = carriageReturn ? line.slice(0, -1) : line;
-		if (this._skipSeparator) {
-			this._skipSeparator = false;
-			if (!content) {
-				return undefined;
-			}
-		}
-		if (!content.startsWith('data:')) {
-			return line;
-		}

+ *--------------------------------------------------------------------------------------------*/
+
+// !!APP_NAME!! removes '@github/copilot-sdk' (the proprietary Copilot binaries
+// can't be redistributed). The HydraFusion progress projection still type-checks
+// structurally against the SDK's fusion event payloads (it narrows on `type`,
+// `Pick`s phase fields and switches exhaustively over the pattern/phase unions),
+// so a bare `any` alias does not compile. These declarations are copied verbatim
+// (doc comments stripped) from @github/copilot-sdk 1.0.15-preview.4
+// dist/generated/session-events.d.ts. Type-only: nothing here is emitted.
+
+export type FusionTurnKind = 'user' | 'compaction';
+
+export interface FusionRouteStartedData {
+	attemptId: string;
+	policy?: string;
+	syntheticModel?: string;
+	turnKind: FusionTurnKind;
+}
+
+export interface FusionRouteStartedEvent {
+	agentId?: string;
+	data: FusionRouteStartedData;
+	ephemeral: true;
+	id: string;
+	parentId: string | null;
+	timestamp: string;
+	type: 'session.fusion_route_started';
+}
+
+export interface FusionCritic {
+	model: string;
+	phaseId: string;
+	reasoningEffort?: string;
+}
+
+export type FusionFollowUpAction = 'reuse_primary' | 'reroute';
+
+export interface FusionFollowUpRecommendation {
+	compactionTurn: FusionFollowUpAction;
+	userTurn: FusionFollowUpAction;
+}
+
+export type FusionPattern = 'single' | 'cascade' | 'critique';
+
+export type FusionPhaseKind = 'primary' | 'judge' | 'repair' | 'draft' | 'critic' | 'revision' | 'follow_up';
+
+export type FusionConversationScope = 'root' | 'review';
+
+export interface FusionPhasePlanStep {
+	conditional: boolean;
+	kind: FusionPhaseKind;
+	role: string;
+	scope: FusionConversationScope;
+}
+
+export interface FusionScores {
+	codeGen: number;
+	debugging: number;
+	reasoning: number;
+	toolUse: number;
+}
+
+export interface FusionResolvedData {
+	contractVersion: number;
+	critics?: FusionCritic[];
+	fallbackModel: string;
+	followUp?: FusionFollowUpRecommendation;
+	followUpModel: string;
+	fusionId: string;
+	hint?: string;
+	judgeModel?: string;
+	modelUniverseVersion?: string;
+	pattern: FusionPattern;
+	phasePlan?: FusionPhasePlanStep[];
+	planVersion?: string;
+	policy: string;
+	policyVersion?: string;
+	primaryModel: string;
+	repairModel?: string;

-			request.log.info(`[LocalModelArchitecture] ${parsed.kind === 'found' ? 'Read general.architecture' : `general.architecture is unknown (${parsed.reason})`} from the first ${prefix.byteLength} bytes at ${hostForLog(file.url)}`);

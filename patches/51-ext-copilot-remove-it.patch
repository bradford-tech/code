-			return await resolveCopilotManagedSettings(rpc, token, COPILOT_MANAGED_SETTINGS_TIMEOUT_MS, workingDirectory, generation);
-		} catch (error) {
-			if (generation.isCancellationRequested && !this._store.isDisposed) {

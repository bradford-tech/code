-		// WSL launchers — bash inside, but invoked via these stubs
-		case 'wsl':
-		case 'ubuntu':
-		case 'ubuntu1804':
-		case 'kali':
-		case 'debian':
-		case 'opensuse-42':
-		case 'sles-12':
-			return 'bash';
-		default:
-			return platform.isWindows ? 'powershell' : 'bash';
-	}
